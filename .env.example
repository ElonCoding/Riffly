# Copy this file to .env and fill in local values. Never commit .env.
# See SECURITY.md in discord-music-bot-docs/ for secret-handling rules.

# Discord bot token from the Developer Portal.
DISCORD_TOKEN=

# Application (client) ID of the bot application.
DISCORD_CLIENT_ID=

# Optional: register slash commands to a single development guild.
DISCORD_GUILD_ID=

# Lavalink audio node settings (defaults: localhost, port 2333, password youshallnotpass)
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
