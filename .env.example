# Copy this file to .env and fill in local values. Never commit .env.
# See SECURITY.md in discord-music-bot-docs/ for secret-handling rules.

# Discord bot token from the Developer Portal.
DISCORD_TOKEN=

# Application (client) ID of the bot application.
DISCORD_CLIENT_ID=

# Optional: register slash commands to a single development guild.
DISCORD_GUILD_ID=

# Lavalink audio node settings (defaults: localhost, port 2333, password youshallnotpass)
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# Database connection (PostgreSQL / Supabase)
# For Supabase: DATABASE_URL uses pooler (port 6543), DIRECT_URL uses direct (port 5432)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Web Dashboard (Optional)
DASHBOARD_PORT=3000
DASHBOARD_API_KEY=riffly_secret_api_key_123

# Google Gemini AI Configuration (Optional)
GEMINI_API_KEY=
GEMINI_PROJECT_NAME=
GEMINI_PROJECT_NUMBER=
